# ==============================================================================
# EnglishFlow — Local Development Infrastructure Environment Variables
# Copy this file to infra/.env and configure your local credentials.
# WARNING: infra/.env contains secrets and must NEVER be committed to Git.
# ==============================================================================

# Database Name
POSTGRES_DB=englishflow

# Database Superuser / Service Account
POSTGRES_USER=englishflow

# Database Password (Development Only — Replace with your local secure secret)
POSTGRES_PASSWORD=replace_with_local_dev_password

# Host Port Binding (Default: 5432)
POSTGRES_PORT=5432
