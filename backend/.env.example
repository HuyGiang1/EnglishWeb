# ==============================================================================
# EnglishFlow — Local Backend Environment Configuration
# Copy this file to backend/.env if running backend standalone, or use scripts/backend-dev.sh
# which automatically reads credentials from infra/.env
# ==============================================================================

# Database Connection Settings
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/englishflow
SPRING_DATASOURCE_USERNAME=englishflow
SPRING_DATASOURCE_PASSWORD=replace_with_local_dev_password

# Server Port (Default: 8080)
SERVER_PORT=8080
